<group name="local,syscheck,">

  <rule id="100010" level="7">
    <if_sid>syscheck</if_sid>
    <match>.zip' added</match>
    <description>ZIP Archive added to the system: $(syscheck.path)</description>
  </rule>

  <rule id="100020" level="5">
    <match>wazuh-zip-analyzer:</match> 
    <description>Zip Analyzer: Sedang memeriksa isi file ZIP...</description>
  </rule>

  <rule id="100021" level="10">
    <if_sid>100020</if_sid>
    <match>"is_pe": true|"is_pe":true</mat
