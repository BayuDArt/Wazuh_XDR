<group name="chimera_cti,">

  <rule id="100600" level="3">
    <decoded_as>json</decoded_as>
    <field name="scores.status" type="pcre2">.+</field> 
    <description>Chimera CTI: Log analisis reputasi diterima.</description>
  </rule>

  <rule id="100101" level="7">
    <if_sid>100600</if_sid>
    <field name="scores.status">SUSPICIOUS</field>
    <description>Chimera CTI: File $(target.filename) MENCURIGAKAN (Skor: $(scores.final_score))</description>
    <mitre>
      <id>T1204.002</id>
    </mitre>
  </rule>

  <rule id="100102" level="12">
    <if_sid>100600</if_sid>
    <field name="scores.status">MALICIOUS</field>
    <description>Chimera CTI: TERDETEKSI MALWARE! File: $(target.filename) | Hash: $(target.file_hash)</description>
    <mitre>
      <id>T1588.002</id>
    </mitre>
  </rule>

  <rule id="100103" level="3">
    <if_sid>100600</if_sid>
    <field name="scores.status">NORMAL</field>
    <description>Chimera CTI: File $(target.filename) dinyatakan aman.</description>
  </rule>

</group>

<group name="local,malware,">

  <rule id="100002" level="12">
    <if_sid>554, 550</if_sid>
    <list field="sha256" lookup="match_key">etc/lists/malware-hashes</list>
    <description>CDB Hashes list: File terindikasi Blacklist terdeteksi: $(file)</description>
    <mitre>
      <id>T1204.002</id>
    </mitre>
  </rule>
  
  <rule id="100003" level="5">
    <if_sid>100002</if_sid>
    <field name="file" type="pcre2">(?i)[c-z]:</field>
    <description>A file - $(file) - malware blacklist ditambahkan ke sistem.</description>
  </rule>

</group>

<group name="chimera_soar,">

  <rule id="100100" level="3">
    <decoded_as>json</decoded_as>
    <field name="chimera.action" type="pcre2">.+</field> 
    <description>SOAR: Log Active-Response diterima.</description>
  </rule>
  
  <rule id="100500" level="12">
    <if_sid>100100</if_sid> 
    <field name="chimera.action">remove-threat</field>
    <description>SOAR: Mengeksekusi penghapusan malware.</description>
  </rule>
  
  <rule id="100501" level="12">
    <if_sid>100100</if_sid>
    <field name="chimera.action">block-mikrotik</field>
    <description>SOAR: Mengeksekusi blokir IP Penyerang di MikroTik.</description>
  </rule>

</group>

<group name="suricata, chimera_nids,">
  <rule id="100250" level="5">
    <if_sid>86600</if_sid>
    <field name="event_type">^fileinfo$</field>
    <field name="fileinfo.sha256">\.+</field>
    <description>CHIMERA NIDS: Ekstraksi File Terdeteksi dari Jaringan (Hash: $(fileinfo.sha256))</description>
  </rule>
</group>